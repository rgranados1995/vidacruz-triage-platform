# Copy to .env to override the local defaults of docker-compose.yml. Never commit .env.
POSTGRES_USER=triage
POSTGRES_PASSWORD=<local-password>
# API key of triage-service (header X-API-Key), at least 16 characters
TRIAGE_API_KEY=<api-key>
# API key of clinical-assistant-service (header X-API-Key), at least 16 characters
ASSISTANT_API_KEY=<api-key>
# Key of the Anthropic API for the clinical assistant; without it the assistant runs in degraded mode
ANTHROPIC_API_KEY=<anthropic-api-key>
