    {
      "name": "2 · Escalamiento y alertas (modo demo)",
      "description": "Necesita el modo demo (SLA de CRITICO en 1 minuto). La primera petición espera sola hasta que pasen 70 segundos desde que se registró E1.",
      "auth": {
        "type": "apikey",
        "apikey": [
          {
            "key": "key",
            "value": "X-API-Key",
            "type": "string"
          },
          {
            "key": "value",
            "value": "{{triageApiKey}}",
            "type": "string"
          },
          {
            "key": "in",
            "value": "header",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "E1 quedó escalado (espera ~70 s)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{triageUrl}}/triage/pacientes/{{pacienteCriticoId}}",
