{
  "info": {
    "name": "VidaCruz · Triage y Asistente Clínico (local)",
    "description": "Pruebas de los dos microservicios en local. Antes, levanta todo en modo demo desde la raíz del repositorio:\n\ndocker compose -f docker-compose.yml -f docker-compose.demo.yml up -d --build\n\nCorre las carpetas en orden (0, 1, 2, 3) o toda la colección con Run collection. Las llaves son las de desarrollo local del docker-compose.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "triageUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "asistenteUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "triageApiKey",
      "value": "local-dev-api-key-0001"
    },
    {
      "key": "asistenteApiKey",
      "value": "local-dev-assistant-key-0001"
    },
    {
      "key": "pacienteCriticoId",
      "value": ""
    },
    {
      "key": "pacienteE4Id",
      "value": ""
    },
    {
      "key": "pacienteE5Id",
      "value": ""
    },
    {
      "key": "criticoRegistradoEn",
      "value": ""
    },
    {
      "key": "alertaId",
      "value": ""
    },
    {
      "key": "reporteDesde",
      "value": ""
    },
    {
      "key": "reporteHasta",
      "value": ""
