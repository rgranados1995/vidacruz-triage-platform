          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const registered = Number(pm.collectionVariables.get(\"criticoRegistradoEn\") || 0);",
                  "const wait = Math.max(0, 70000 - (Date.now() - registered));",
                  "console.log(\"Esperando \" + Math.round(wait / 1000) + \" s a que el monitor de SLA escale a E1...\");",
                  "setTimeout(() => {}, wait);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
