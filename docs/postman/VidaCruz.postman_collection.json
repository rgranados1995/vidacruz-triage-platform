    {
      "name": "1 · Triaje: registro, estados y reporte",
      "description": "Registra los pacientes E1 a E6 del enunciado y recorre el flujo de estados. Los ids se guardan solos en las variables de la colección.",
      "auth": {
        "type": "apikey",
        "apikey": [
          {
            "key": "key",
            "value": "X-API-Key",
            "type": "string"
          },
          {
            "key": "value",
            "value": "{{triageApiKey}}",
            "type": "string"
          },
          {
            "key": "in",
            "value": "header",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Registrar E1 · CRITICO (dolor torácico)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{triageUrl}}/triage/pacientes",
            "description": "Paciente del enunciado. Nivel esperado: CRITICO.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreCompleto\": \"Ana María Pérez\",\n  \"edad\": 54,\n  \"frecuenciaCardiaca\": 130,\n  \"presionSistolica\": 180,\n  \"presionDiastolica\": 110,\n  \"spo2\": 97,\n  \"temperatura\": 36.8,\n  \"dolor\": 8,\n  \"gcs\": 15,\n  \"quejaPrincipal\": \"Dolor torácico\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Nivel CRITICO\", () => pm.expect(body.nivel).to.eql(\"CRITICO\"));",
                  "pm.test(\"Queda REGISTRADO\", () => pm.expect(body.estado).to.eql(\"REGISTRADO\"));",
                  "pm.collectionVariables.set(\"pacienteCriticoId\", body.id);",
                  "pm.collectionVariables.set(\"criticoRegistradoEn\", Date.now());"
                ]
              }
            }
          ]
        },
